# Copy to .env.local for local development.

# --- Session (HMAC-signed cookie) -------------------------------------------
# Required in production. In development a fixed dev secret is used if unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Database (Supabase Postgres) -------------------------------------------
# Optional for local UI work: when unset, repositories fall back to read-only
# demo fixtures (db/seed/fixtures.ts) so the app still runs on a laptop.
# Use the Supabase *direct* or *session pooler* connection string.
DATABASE_URL=

# --- Dev login (fixture mode only) ------------------------------------------
# Password for the demo users in db/seed/fixtures.ts. Also used by `npm run db:seed`.
DEMO_PASSWORD=nexife-demo

# --- Assistant (not wired yet — see server/assistant/README.md) -------------
# OPENAI_API_KEY=
# ASSISTANT_SUPABASE_URL=
# ASSISTANT_SUPABASE_KEY=
